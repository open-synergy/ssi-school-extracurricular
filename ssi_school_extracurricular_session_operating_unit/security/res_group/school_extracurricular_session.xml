<odoo>
<record id="school_extracurricular_session_operating_unit_group" model="res.groups">
    <field name="name">Operating Unit</field>
    <field
            name="category_id"
            ref="school_extracurricular_session_operating_unit_module_category"
        />
</record>

<!-- Extend (not replace) the session's existing Manager group so its
     members keep seeing/writing every operating unit's sessions. -->
<record
        id="ssi_school_extracurricular_session.school_extracurricular_session_manager_group"
        model="res.groups"
    >
    <field
            name="implied_ids"
            eval="[(4, ref('school_extracurricular_session_operating_unit_group'))]"
        />
</record>
</odoo>
