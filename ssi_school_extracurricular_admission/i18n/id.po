#. module: ssi_school_extracurricular_admission
#: code:addons/ssi_school_extracurricular_admission/models/school_extracurricular_participant.py:0
#, python-format
msgid ""
"\n"
"Context: Cancel extracurricular participant\n"
"Database ID: %(id)s\n"
"Problem: An admission addendum fee line is already linked to a\n"
"customer invoice line\n"
"Solution: Delete or disconnect the customer invoice from the\n"
"admission payment term before cancelling this participant\n"
msgstr ""
"\n"
"Konteks: Batalkan peserta ekstrakurikuler\n"
"ID Basis Data: %(id)s\n"
"Masalah: Baris biaya adendum penerimaan sudah terhubung dengan baris\n"
"faktur pelanggan\n"
"Solusi: Hapus atau putuskan faktur pelanggan dari termin pembayaran\n"
"penerimaan sebelum membatalkan peserta ini\n"

#. module: ssi_school_extracurricular_admission
#: code:addons/ssi_school_extracurricular_admission/models/school_extracurricular_participant.py:0
#, python-format
msgid ""
"\n"
"Context: Open extracurricular participant\n"
"Database ID: %(id)s\n"
"Problem: Allocated Admission Payment Term '%(term)s' is already\n"
"%(state)s\n"
"Solution: Remove or replace the Admission Allocation line pointing to\n"
"that Payment Term before opening\n"
msgstr ""
"\n"
"Konteks: Buka peserta ekstrakurikuler\n"
"ID Basis Data: %(id)s\n"
"Masalah: Termin Pembayaran Penerimaan yang dialokasikan '%(term)s'\n"
"sudah %(state)s\n"
"Solusi: Hapus atau ganti baris Alokasi Penerimaan yang menunjuk ke\n"
"Termin Pembayaran tersebut sebelum membuka\n"

#. module: ssi_school_extracurricular_admission
#: code:addons/ssi_school_extracurricular_admission/models/school_extracurricular_participant.py:0
#, python-format
msgid ""
"\n"
"Context: Open extracurricular participant\n"
"Database ID: %(id)s\n"
"Problem: Billing Mode is 'Charged to Admission' but enrollment\n"
"Allocation line(s) are still set\n"
"Solution: Remove the enrollment Allocation line(s) before opening\n"
msgstr ""
"\n"
"Konteks: Buka peserta ekstrakurikuler\n"
"ID Basis Data: %(id)s\n"
"Masalah: Mode Penagihan adalah 'Dibebankan ke Penerimaan' tetapi baris\n"
"Alokasi pendaftaran masih terisi\n"
"Solusi: Hapus baris Alokasi pendaftaran sebelum membuka\n"

#. module: ssi_school_extracurricular_admission
#: code:addons/ssi_school_extracurricular_admission/models/school_extracurricular_participant.py:0
#, python-format
msgid ""
"\n"
"Context: Open extracurricular participant\n"
"Database ID: %(id)s\n"
"Problem: Billing Mode is 'Charged to Admission' but no Admission\n"
"Allocation line is set\n"
"Solution: Add at least one Admission Allocation line pointing to an\n"
"admission payment term before opening\n"
msgstr ""
"\n"
"Konteks: Buka peserta ekstrakurikuler\n"
"ID Basis Data: %(id)s\n"
"Masalah: Mode Penagihan adalah 'Dibebankan ke Penerimaan' tetapi tidak\n"
"ada baris Alokasi Penerimaan\n"
"Solusi: Tambahkan setidaknya satu baris Alokasi Penerimaan yang menunjuk\n"
"ke termin pembayaran penerimaan sebelum membuka\n"

#. module: ssi_school_extracurricular_admission
#: code:addons/ssi_school_extracurricular_admission/models/school_extracurricular_participant.py:0
#, python-format
msgid ""
"\n"
"Context: Open extracurricular participant\n"
"Database ID: %(id)s\n"
"Problem: Billing Mode is 'Charged to Admission' but no Admission is\n"
"set\n"
"Solution: Select an Admission before opening\n"
msgstr ""
"\n"
"Konteks: Buka peserta ekstrakurikuler\n"
"ID Basis Data: %(id)s\n"
"Masalah: Mode Penagihan adalah 'Dibebankan ke Penerimaan' tetapi\n"
"Penerimaan belum diatur\n"
"Solusi: Pilih Penerimaan sebelum membuka\n"

#. module: ssi_school_extracurricular_admission
#: code:addons/ssi_school_extracurricular_admission/models/school_extracurricular_participant.py:0
#, python-format
msgid ""
"\n"
"Context: Set extracurricular participant admission\n"
"Database ID: %s\n"
"Problem: Admission '%s' does not belong to Student '%s'\n"
"Solution: Select an Admission that belongs to the selected Student\n"
msgstr ""
"\n"
"Konteks: Atur penerimaan peserta ekstrakurikuler\n"
"ID Basis Data: %s\n"
"Masalah: Penerimaan '%s' bukan milik Siswa '%s'\n"
"Solusi: Pilih Penerimaan yang dimiliki oleh Siswa yang dipilih\n"

#. module: ssi_school_extracurricular_admission
#: code:addons/ssi_school_extracurricular_admission/models/school_extracurricular_participant.py:0
#, python-format
msgid ""
"\n"
"Context: Set extracurricular participant admission\n"
"Database ID: %s\n"
"Problem: Admission academic term '%s' does not match Offering\n"
"academic term '%s'\n"
"Solution: Select an Admission for the same academic term as the\n"
"Offering\n"
msgstr ""
"\n"
"Konteks: Atur penerimaan peserta ekstrakurikuler\n"
"ID Basis Data: %s\n"
"Masalah: Periode akademik penerimaan '%s' tidak sama dengan periode\n"
"akademik Penyelenggaraan '%s'\n"
"Solusi: Pilih Penerimaan untuk periode akademik yang sama dengan\n"
"Penyelenggaraan\n"

#. module: ssi_school_extracurricular_admission
#: code:addons/ssi_school_extracurricular_admission/models/school_extracurricular_participant_admission_allocation.py:0
#, python-format
msgid ""
"\n"
"Context: Set extracurricular participant admission allocation\n"
"Database ID: %s\n"
"Problem: Payment term '%s' does not belong to the same admission as\n"
"Participant '%s'\n"
"Solution: Select a Payment Term that belongs to the Participant's\n"
"Admission\n"
msgstr ""
"\n"
"Konteks: Atur alokasi penerimaan peserta ekstrakurikuler\n"
"ID Basis Data: %s\n"
"Masalah: Termin pembayaran '%s' bukan bagian dari penerimaan yang sama\n"
"dengan Peserta '%s'\n"
"Solusi: Pilih Termin Pembayaran yang termasuk dalam Penerimaan Peserta\n"

#. module: ssi_school_extracurricular_admission
#: code:addons/ssi_school_extracurricular_admission/models/school_extracurricular_participant_admission_allocation.py:0
#, python-format
msgid ""
"\n"
"Context: Set extracurricular participant admission allocation\n"
"Database ID: %s\n"
"Problem: Payment term '%s' is already %s\n"
"Solution: Select a Payment Term that is not invoiced, paid, voided or\n"
"cancelled\n"
msgstr ""
"\n"
"Konteks: Atur alokasi penerimaan peserta ekstrakurikuler\n"
"ID Basis Data: %s\n"
"Masalah: Termin pembayaran '%s' sudah %s\n"
"Solusi: Pilih Termin Pembayaran yang belum difakturkan, dibayar,\n"
"dibatalkan, atau dibatalkan secara administratif (void)\n"

#. module: ssi_school_extracurricular_admission
#: code:addons/ssi_school_extracurricular_admission/models/school_extracurricular_participant_admission_allocation.py:0
#, python-format
msgid ""
"\n"
"Context: Set extracurricular participant admission allocation\n"
"Database ID: %s\n"
"Problem: Total allocation %s does not match Participant fee %s\n"
"Solution: Adjust the allocation lines so their total matches the\n"
"Participant's Untaxed Amount\n"
msgstr ""
"\n"
"Konteks: Atur alokasi penerimaan peserta ekstrakurikuler\n"
"ID Basis Data: %s\n"
"Masalah: Total alokasi %s tidak sama dengan biaya Peserta %s\n"
"Solusi: Sesuaikan baris alokasi sehingga totalnya sama dengan Jumlah\n"
"Sebelum Pajak Peserta\n"

#. module: ssi_school_extracurricular_admission
#: code:addons/ssi_school_extracurricular_admission/models/school_extracurricular_participant.py:0
#, python-format
msgid ""
"\n"
"Context: Set extracurricular participant enrollment\n"
"Database ID: %s\n"
"Problem: Enrollment is required when Billing Mode is not Charged to\n"
"Admission\n"
"Solution: Select an Enrollment, or change Billing Mode to Charged to\n"
"Admission\n"
msgstr ""
"\n"
"Konteks: Atur pendaftaran peserta ekstrakurikuler\n"
"ID Basis Data: %s\n"
"Masalah: Pendaftaran wajib diisi bila Mode Penagihan bukan Dibebankan\n"
"ke Penerimaan\n"
"Solusi: Pilih Pendaftaran, atau ubah Mode Penagihan menjadi Dibebankan\n"
"ke Penerimaan\n"

