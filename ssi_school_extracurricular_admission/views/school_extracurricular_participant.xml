<odoo>
<record id="school_extracurricular_participant_view_form" model="ir.ui.view">
    <field name="name">school_extracurricular_participant - admission - form</field>
    <field name="model">school_extracurricular_participant</field>
    <field
            name="inherit_id"
            ref="ssi_school_extracurricular.school_extracurricular_participant_view_form"
        />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='enrollment_id']" position="attributes">
                <attribute
                        name="attrs"
                    >{'required': [('billing_mode', '!=', 'admission')], 'readonly': [('state', '!=', 'draft')]}</attribute>
            </xpath>
            <xpath expr="//field[@name='enrollment_id']" position="after">
                <field
                        name="admission_id"
                        attrs="{'invisible': [('billing_mode', '!=', 'admission')], 'readonly': [('state', '!=', 'draft')]}"
                    />
            </xpath>
            <xpath expr="//field[@name='allocation_ids']" position="attributes">
                <attribute
                        name="attrs"
                    >{'readonly': [('state','!=','draft')], 'invisible': [('billing_mode', '=', 'admission')]}</attribute>
            </xpath>
            <xpath expr="//field[@name='allocation_ids']" position="after">
                <field
                        name="admission_allocation_ids"
                        colspan="4"
                        nolabel="1"
                        attrs="{'readonly': [('state','!=','draft')], 'invisible': [('billing_mode', '!=', 'admission')]}"
                    >
                    <tree editable="bottom">
                        <field name="sequence" widget="handle" />
                        <field name="payment_term_id" />
                        <field name="product_id" />
                        <field name="name" />
                        <field name="account_id" />
                        <field name="currency_id" invisible="1" />
                        <field name="uom_id" />
                        <field name="uom_quantity" string="Quantity" />
                        <field name="price_unit" />
                        <field name="price_subtotal" />
                        <field name="tax_ids" widget="many2many_tags" />
                        <field name="price_tax" />
                        <field name="price_total" />
                    </tree>
                    <form>
                        <header />
                        <sheet>
                            <group
                                    name="admission_allocation_group"
                                    colspan="4"
                                    col="2"
                                >
                                <group
                                        name="admission_allocation_left"
                                        colspan="1"
                                        col="2"
                                    >
                                    <field name="payment_term_id" />
                                    <field name="product_id" />
                                    <field name="name" />
                                    <field name="account_id" />
                                </group>
                                <group
                                        name="admission_allocation_right"
                                        colspan="1"
                                        col="2"
                                    >
                                    <field name="currency_id" invisible="1" />
                                    <field name="uom_id" />
                                    <field name="uom_quantity" string="Quantity" />
                                    <field name="price_unit" />
                                    <field name="price_subtotal" />
                                    <field name="tax_ids" widget="many2many_tags" />
                                    <field name="price_tax" />
                                    <field name="price_total" />
                                </group>
                            </group>
                        </sheet>
                    </form>
                </field>
            </xpath>
        </data>
    </field>
</record>
</odoo>
