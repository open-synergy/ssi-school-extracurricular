<odoo>
<record id="school_extracurricular_offering_user_group" model="res.groups">
    <field name="name">User</field>
    <field
            name="category_id"
            ref="school_extracurricular_offering_workflow_module_category"
        />
</record>

<record id="school_extracurricular_offering_officer_group" model="res.groups">
    <field name="name">Officer</field>
    <field
            name="category_id"
            ref="school_extracurricular_offering_workflow_module_category"
        />
    <field
            name="implied_ids"
            eval="[(4, ref('school_extracurricular_offering_user_group'))]"
        />
</record>

<record id="school_extracurricular_offering_manager_group" model="res.groups">
    <field name="name">Manager</field>
    <field
            name="category_id"
            ref="school_extracurricular_offering_workflow_module_category"
        />
    <field
            name="implied_ids"
            eval="[(4, ref('school_extracurricular_offering_officer_group'))]"
        />
    <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
</record>

</odoo>
