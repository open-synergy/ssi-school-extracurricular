<!-- The menuitem is kept out of wizards/school_extracurricular_create_due_invoice.xml
     on purpose: wizard view/action files may not embed a menuitem (they have
     no menu of their own; see odoo-development skill, 10-wizard.md), and
     menu.xml itself loads before the wizard's action, so the action id would
     not exist yet if the menuitem lived there instead. This file is loaded
     after the wizard's action (see __manifest__.py) so the reference resolves. -->
<odoo>
<menuitem
        id="menu_extracurricular_create_due_invoice"
        name="Create Due Invoice"
        parent="menu_extracurricular_root"
        action="school_extracurricular_create_due_invoice_action"
        groups="school_extracurricular_participant_user_group"
        sequence="30"
    />
</odoo>
