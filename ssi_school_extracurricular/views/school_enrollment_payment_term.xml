<odoo>
<record id="school_enrollment_payment_term_view_tree_inherit" model="ir.ui.view">
    <field name="name">school_enrollment_payment_term - tree - extracurricular</field>
    <field name="model">school_enrollment_payment_term</field>
    <field
            name="inherit_id"
            ref="ssi_school.school_enrollment_payment_term_view_tree"
        />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='amount_untaxed']" position="after">
                <field name="amount_extra" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_enrollment_payment_term_view_form_inherit" model="ir.ui.view">
    <field name="name">school_enrollment_payment_term - form - extracurricular</field>
    <field name="model">school_enrollment_payment_term</field>
    <field
            name="inherit_id"
            ref="ssi_school.school_enrollment_payment_term_view_form"
        />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='amount_untaxed']" position="after">
                <field name="amount_extra" />
            </xpath>
        </data>
    </field>
</record>
</odoo>
