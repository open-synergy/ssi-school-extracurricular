<odoo>

<record id="school_extracurricular_fee_analysis_view_search" model="ir.ui.view">
    <field name="name">school_extracurricular_fee_analysis - search</field>
    <field name="model">school_extracurricular_fee_analysis</field>
    <field name="arch" type="xml">
        <search string="Extracurricular Fee Analysis">
            <field name="participant_id" />
            <field name="extracurricular_id" />
            <field name="student_id" />
            <field name="school_id" />
            <field name="academic_year_id" />
            <field name="academic_term_id" />
            <field name="product_id" />
            <filter
                    name="filter_route_enrollment"
                    string="Charged to Enrollment"
                    domain="[('billing_route','=','enrollment')]"
                />
            <filter
                    name="filter_route_standalone"
                    string="Separate Invoice"
                    domain="[('billing_route','=','standalone')]"
                />
            <group expand="0" string="Group By">
                <filter
                        name="group_by_billing_route"
                        string="Billing Route"
                        context="{'group_by': 'billing_route'}"
                    />
                <filter
                        name="group_by_academic_year_id"
                        string="Academic Year"
                        context="{'group_by': 'academic_year_id'}"
                    />
                <filter
                        name="group_by_academic_term_id"
                        string="Academic Term"
                        context="{'group_by': 'academic_term_id'}"
                    />
                <filter
                        name="group_by_category_id"
                        string="Category"
                        context="{'group_by': 'category_id'}"
                    />
                <filter
                        name="group_by_extracurricular_id"
                        string="Extracurricular"
                        context="{'group_by': 'extracurricular_id'}"
                    />
                <filter
                        name="group_by_school_id"
                        string="School"
                        context="{'group_by': 'school_id'}"
                    />
                <filter
                        name="group_by_product_id"
                        string="Product"
                        context="{'group_by': 'product_id'}"
                    />
            </group>
        </search>
    </field>
</record>

<record id="school_extracurricular_fee_analysis_view_pivot" model="ir.ui.view">
    <field name="name">school_extracurricular_fee_analysis - pivot</field>
    <field name="model">school_extracurricular_fee_analysis</field>
    <field name="arch" type="xml">
        <pivot string="Extracurricular Fee Analysis" disable_linking="True">
            <field name="academic_year_id" type="row" />
            <field name="academic_term_id" type="row" />
            <field name="category_id" type="row" />
            <field name="extracurricular_id" type="row" />
            <field name="billing_route" type="col" />
            <field name="uom_quantity" type="measure" />
            <field name="price_subtotal" type="measure" />
            <field name="price_tax" type="measure" />
            <field name="price_total" type="measure" />
        </pivot>
    </field>
</record>

<record id="school_extracurricular_fee_analysis_view_tree" model="ir.ui.view">
    <field name="name">school_extracurricular_fee_analysis - tree</field>
    <field name="model">school_extracurricular_fee_analysis</field>
    <field name="arch" type="xml">
        <tree create="false" edit="false" delete="false">
            <field name="billing_route" />
            <field name="participant_id" />
            <field name="student_id" />
            <field name="extracurricular_id" />
            <field name="category_id" />
            <field name="school_id" />
            <field name="academic_year_id" />
            <field name="academic_term_id" />
            <field name="product_id" />
            <field name="uom_quantity" />
            <field name="price_subtotal" sum="Untaxed" />
            <field name="price_tax" sum="Tax" />
            <field name="price_total" sum="Total" />
        </tree>
    </field>
</record>

<record id="school_extracurricular_fee_analysis_action" model="ir.actions.act_window">
    <field name="name">Extracurricular Fee Analysis</field>
    <field name="res_model">school_extracurricular_fee_analysis</field>
    <field name="view_mode">pivot,tree</field>
    <field
            name="search_view_id"
            ref="school_extracurricular_fee_analysis_view_search"
        />
</record>

<menuitem
        id="school_extracurricular_fee_analysis_menu"
        name="Fee Analysis"
        parent="menu_extracurricular_report"
        action="school_extracurricular_fee_analysis_action"
        groups="school_extracurricular_fee_analysis_group"
    />

</odoo>
