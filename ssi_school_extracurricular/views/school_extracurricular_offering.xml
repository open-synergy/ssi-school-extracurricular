<odoo>
<record id="school_extracurricular_offering_view_search" model="ir.ui.view">
    <field name="name">school_extracurricular_offering - search</field>
    <field name="model">school_extracurricular_offering</field>
    <field
            name="inherit_id"
            ref="ssi_transaction_mixin.mixin_transaction_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//search" position="inside">
                <field name="extracurricular_id" />
                <field name="school_id" />
                <field name="academic_year_id" />
                <field name="academic_term_id" />
                <field name="teacher_id" />
                <group expand="0" string="Group By">
                    <filter
                            name="group_by_extracurricular_id"
                            string="Extracurricular"
                            context="{'group_by': 'extracurricular_id'}"
                        />
                    <filter
                            name="group_by_school_id"
                            string="School"
                            context="{'group_by': 'school_id'}"
                        />
                    <filter
                            name="group_by_academic_term_id"
                            string="Academic Term"
                            context="{'group_by': 'academic_term_id'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="school_extracurricular_offering_view_tree" model="ir.ui.view">
    <field name="name">school_extracurricular_offering - tree</field>
    <field name="model">school_extracurricular_offering</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_tree" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="date" />
                <field name="extracurricular_id" />
                <field name="school_id" />
                <field name="academic_term_id" />
                <field name="teacher_id" />
                <field name="date_start" />
                <field name="date_end" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_extracurricular_offering_view_form" model="ir.ui.view">
    <field name="name">school_extracurricular_offering - form</field>
    <field name="model">school_extracurricular_offering</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="extracurricular_id" />
                <field name="category_id" />
                <field name="school_id" />
                <field name="teacher_id" />
            </xpath>
            <xpath expr="//group[@name='header_right']" position="inside">
                <field name="academic_year_id" />
                <field name="academic_term_id" />
                <field name="date_start" />
                <field name="date_end" />
            </xpath>
            <xpath expr="//page[1]" position="before">
                <page name="quota" string="Quota">
                    <group name="quota_group_1" string="Quota">
                        <field name="quota_min" />
                        <field name="quota_max" />
                    </group>
                </page>
                <page name="billing" string="Billing">
                    <group name="billing_group_1" string="Fee">
                        <field name="currency_id" />
                        <field name="pricelist_id" />
                        <field name="product_id" />
                        <field name="price_unit" />
                        <field name="tax_ids" widget="many2many_tags" />
                    </group>
                    <group name="billing_group_2" string="Billing Setting">
                        <field name="billing_mode" />
                        <field name="billing_frequency" />
                    </group>
                </page>
                <page name="participant" string="Participants">
                    <field
                            name="participant_ids"
                            context="{'form_view_ref': 'ssi_school_extracurricular.school_extracurricular_participant_view_form'}"
                        >
                        <tree>
                            <field name="student_id" />
                            <field name="enrollment_id" />
                            <field name="date_join" />
                            <field name="date_leave" />
                            <field name="amount_total" />
                            <field name="state" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="school_extracurricular_offering_action" model="ir.actions.act_window">
    <field name="name">Extracurricular Offerings</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_extracurricular_offering</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="menu_extracurricular_offering"
        name="Extracurricular Offerings"
        parent="menu_extracurricular_root"
        action="school_extracurricular_offering_action"
        groups="school_extracurricular_offering_user_group"
        sequence="10"
    />

</odoo>
