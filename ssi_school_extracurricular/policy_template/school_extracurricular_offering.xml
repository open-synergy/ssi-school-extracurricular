            search="[('model_id.model','=','school_extracurricular_offering'),('name','=','reject_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','school_extracurricular_offering'),('value','=','confirm')]"
        />
    <field name="restrict_user" eval="0" />
