<odoo>
<record
        id="school_extracurricular_session_view_form_instructor_outsource_work"
        model="ir.ui.view"
    >
    <field name="name">
        school_extracurricular_session - form - instructor - outsource work
    </field>
    <field name="model">school_extracurricular_session</field>
    <field
            name="inherit_id"
            ref="ssi_school_extracurricular_session.school_extracurricular_session_view_form"
        />
    <field name="arch" type="xml">
        <xpath
                expr="//field[@name='instructor_ids']/tree/field[@name='partner_id']"
                position="after"
            >
            <field name="outsource_work_type_id" />
            <field name="outsource_work_usage_id" />
        </xpath>
        <xpath
                expr="//field[@name='instructor_ids']/form/group[@name='instructor_group_1']/field[@name='partner_id']"
                position="after"
            >
            <field name="outsource_work_type_id" />
            <field name="outsource_work_usage_id" />
        </xpath>
    </field>
</record>
</odoo>
