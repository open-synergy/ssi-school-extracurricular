#. module: ssi_school_extracurricular_session_outsource_work
#: code:addons/ssi_school_extracurricular_session_outsource_work/models/school_extracurricular_session.py:0
#, python-format
msgid ""
"\n"
"Context: Cancel or restart extracurricular session\n"
"Database ID: %s\n"
"Problem: An instructor outsource work log already has an Outstanding\n"
"Solution: Cancel the Outsource Work Outstanding before cancelling or\n"
"restarting this session\n"
msgstr ""
"\n"
"Konteks: Batalkan atau mulai ulang sesi ekstrakurikuler\n"
"ID Basis Data: %s\n"
"Masalah: Log pekerjaan alih daya instruktur sudah memiliki Outstanding\n"
"Solusi: Batalkan Outstanding Pekerjaan Alih Daya sebelum membatalkan\n"
"atau memulai ulang sesi ini\n"

#. module: ssi_school_extracurricular_session_outsource_work
#: code:addons/ssi_school_extracurricular_session_outsource_work/models/school_extracurricular_session.py:0
#, python-format
msgid ""
"\n"
"Context: Create instructor outsource work\n"
"Database ID: %s\n"
"Problem: Instructor roster line for '%s' has no Outsource Work Type\n"
"Solution: Set an Outsource Work Type on the roster line before\n"
"marking the session as done\n"
msgstr ""
"\n"
"Konteks: Buat pekerjaan alih daya instruktur\n"
"ID Basis Data: %s\n"
"Masalah: Baris daftar instruktur untuk '%s' tidak memiliki Jenis\n"
"Pekerjaan Alih Daya\n"
"Solusi: Atur Jenis Pekerjaan Alih Daya pada baris daftar sebelum\n"
"menandai sesi sebagai selesai\n"

#. module: ssi_school_extracurricular_session_outsource_work
#: code:addons/ssi_school_extracurricular_session_outsource_work/models/school_extracurricular_session.py:0
#, python-format
msgid ""
"\n"
"Context: Create instructor outsource work\n"
"Database ID: %s\n"
"Problem: Instructor roster line for '%s' has no Outsource Work Usage\n"
"Solution: Set an Outsource Work Usage on the roster line before\n"
"marking the session as done\n"
msgstr ""
"\n"
"Konteks: Buat pekerjaan alih daya instruktur\n"
"ID Basis Data: %s\n"
"Masalah: Baris daftar instruktur untuk '%s' tidak memiliki Penggunaan\n"
"Pekerjaan Alih Daya\n"
"Solusi: Atur Penggunaan Pekerjaan Alih Daya pada baris daftar sebelum\n"
"menandai sesi sebagai selesai\n"

#. module: ssi_school_extracurricular_session_outsource_work
#: code:addons/ssi_school_extracurricular_session_outsource_work/models/school_extracurricular_session.py:0
#, python-format
msgid ""
"\n"
"Context: Create instructor outsource work\n"
"Database ID: %s\n"
"Problem: No open Outsource Work Rate covers '%s' on '%s'\n"
"Solution: Create an open Outsource Work Rate for this person that\n"
"covers the session date\n"
msgstr ""
"\n"
"Konteks: Buat pekerjaan alih daya instruktur\n"
"ID Basis Data: %s\n"
"Masalah: Tidak ada Tarif Pekerjaan Alih Daya terbuka yang mencakup '%s'\n"
"pada '%s'\n"
"Solusi: Buat Tarif Pekerjaan Alih Daya terbuka untuk orang ini yang\n"
"mencakup tanggal sesi\n"

#. module: ssi_school_extracurricular_session_outsource_work
#: code:addons/ssi_school_extracurricular_session_outsource_work/models/school_extracurricular_session.py:0
#, python-format
msgid ""
"\n"
"Context: Create instructor outsource work\n"
"Database ID: %s\n"
"Problem: Offering '%s' has no Analytic Account\n"
"Solution: Set an Analytic Account on the Offering before marking the\n"
"session as done\n"
msgstr ""
"\n"
"Konteks: Buat pekerjaan alih daya instruktur\n"
"ID Basis Data: %s\n"
"Masalah: Penyelenggaraan '%s' tidak memiliki Akun Analitik\n"
"Solusi: Atur Akun Analitik pada Penyelenggaraan sebelum menandai sesi\n"
"sebagai selesai\n"

