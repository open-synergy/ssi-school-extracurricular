<odoo>
<record id="school_extracurricular_participant_view_form_session" model="ir.ui.view">
    <field name="name">school_extracurricular_participant - form - session recap</field>
    <field name="model">school_extracurricular_participant</field>
    <field
            name="inherit_id"
            ref="ssi_school_extracurricular.school_extracurricular_participant_view_form"
        />
    <field name="arch" type="xml">
        <xpath expr="//div[@name='button_box']" position="inside">
            <button
                    name="action_view_session_planned"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-clock-o"
                >
                <field
                        name="session_planned_count"
                        widget="statinfo"
                        string="Planned Sessions"
                    />
            </button>
            <button
                    name="action_view_session_done"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-check-square-o"
                >
                <field
                        name="session_done_count"
                        widget="statinfo"
                        string="Done Sessions"
                    />
            </button>
            <button
                    name="action_view_attendance_present"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-user"
                >
                <field
                        name="attendance_present_count"
                        widget="statinfo"
                        string="Present"
                    />
            </button>
        </xpath>
        <xpath expr="//group[@name='header_right']" position="inside">
            <field name="attendance_rate" />
        </xpath>
    </field>
</record>
</odoo>
