#. module: ssi_school_extracurricular_session
#: code:addons/ssi_school_extracurricular_session/models/school_extracurricular_session.py:0
#, python-format
msgid ""
"\n"
"Context: Approve extracurricular session\n"
"Database ID: %s\n"
"Problem: Coach Present is unchecked and Monitoring Note is empty\n"
"Solution: Check Coach Present, or fill in a Monitoring Note\n"
"explaining why the meeting still counts as held\n"
msgstr ""
"\n"
"Konteks: Setujui sesi ekstrakurikuler\n"
"ID Basis Data: %s\n"
"Masalah: Pelatih Hadir tidak dicentang dan Catatan Pemantauan kosong\n"
"Solusi: Centang Pelatih Hadir, atau isi Catatan Pemantauan yang\n"
"menjelaskan mengapa pertemuan tetap dianggap berlangsung\n"

#. module: ssi_school_extracurricular_session
#: code:addons/ssi_school_extracurricular_session/wizards/cancel_extracurricular_session.py:0
#, python-format
msgid ""
"\n"
"Context: Cancel extracurricular session\n"
"Database ID: %s\n"
"Problem: Cancel Reason is empty\n"
"Solution: Fill in a Cancel Reason before cancelling the session\n"
msgstr ""
"\n"
"Konteks: Batalkan sesi ekstrakurikuler\n"
"ID Basis Data: %s\n"
"Masalah: Alasan Pembatalan kosong\n"
"Solusi: Isi Alasan Pembatalan sebelum membatalkan sesi\n"

#. module: ssi_school_extracurricular_session
#: code:addons/ssi_school_extracurricular_session/models/school_extracurricular_session.py:0
#, python-format
msgid ""
"\n"
"Context: Confirm extracurricular session\n"
"Database ID: %s\n"
"Problem: Journal - Material or Journal - Activity is empty\n"
"Solution: Fill in both journal fields before confirming this session\n"
msgstr ""
"\n"
"Konteks: Konfirmasi sesi ekstrakurikuler\n"
"ID Basis Data: %s\n"
"Masalah: Jurnal - Materi atau Jurnal - Aktivitas kosong\n"
"Solusi: Isi kedua kolom jurnal sebelum mengonfirmasi sesi ini\n"

#. module: ssi_school_extracurricular_session
#: code:addons/ssi_school_extracurricular_session/models/school_extracurricular_session.py:0
#, python-format
msgid ""
"\n"
"Context: Fill extracurricular session attendance\n"
"Database ID: %s\n"
"Problem: Session is not in Planned state\n"
"Solution: Only a session in Planned state may have its attendance\n"
"filled automatically\n"
msgstr ""
"\n"
"Konteks: Isi kehadiran sesi ekstrakurikuler\n"
"ID Basis Data: %s\n"
"Masalah: Sesi tidak berstatus Direncanakan\n"
"Solusi: Hanya sesi berstatus Direncanakan yang kehadirannya dapat diisi\n"
"otomatis\n"

#. module: ssi_school_extracurricular_session
#: code:addons/ssi_school_extracurricular_session/wizards/school_extracurricular_session_generate.py:0
#, python-format
msgid ""
"\n"
"Context: Generate extracurricular sessions\n"
"Database ID: %s\n"
"Problem: Date range is outside Offering '%s' period\n"
"Solution: Select a Start Date and End Date within the Offering's\n"
"period ('%s' - '%s')\n"
msgstr ""
"\n"
"Konteks: Buat sesi ekstrakurikuler\n"
"ID Basis Data: %s\n"
"Masalah: Rentang tanggal berada di luar periode Penyelenggaraan '%s'\n"
"Solusi: Pilih Tanggal Mulai dan Tanggal Selesai yang berada dalam\n"
"periode Penyelenggaraan ('%s' - '%s')\n"

#. module: ssi_school_extracurricular_session
#: code:addons/ssi_school_extracurricular_session/wizards/school_extracurricular_session_generate.py:0
#, python-format
msgid ""
"\n"
"Context: Generate extracurricular sessions\n"
"Database ID: %s\n"
"Problem: No date in the range matches a checked weekday\n"
"Solution: Widen the date range, or check a weekday that falls\n"
"within it\n"
msgstr ""
"\n"
"Konteks: Buat sesi ekstrakurikuler\n"
"ID Basis Data: %s\n"
"Masalah: Tidak ada tanggal dalam rentang yang cocok dengan hari yang\n"
"dicentang\n"
"Solusi: Perluas rentang tanggal, atau centang hari yang jatuh dalam\n"
"rentang tersebut\n"

#. module: ssi_school_extracurricular_session
#: code:addons/ssi_school_extracurricular_session/wizards/school_extracurricular_session_generate.py:0
#, python-format
msgid ""
"\n"
"Context: Generate extracurricular sessions\n"
"Database ID: %s\n"
"Problem: No weekday is checked\n"
"Solution: Check at least one weekday before generating sessions\n"
msgstr ""
"\n"
"Konteks: Buat sesi ekstrakurikuler\n"
"ID Basis Data: %s\n"
"Masalah: Tidak ada hari yang dicentang\n"
"Solusi: Centang setidaknya satu hari sebelum membuat sesi\n"

#. module: ssi_school_extracurricular_session
#: code:addons/ssi_school_extracurricular_session/models/school_extracurricular_session.py:0
#, python-format
msgid ""
"\n"
"Context: Mark extracurricular session as done\n"
"Database ID: %s\n"
"Problem: An instructor roster line has no Attendance recorded\n"
"Solution: Record the Attendance of every instructor roster line\n"
"before marking the session as done\n"
msgstr ""
"\n"
"Konteks: Tandai sesi ekstrakurikuler selesai\n"
"ID Basis Data: %s\n"
"Masalah: Ada baris daftar instruktur yang Kehadirannya belum dicatat\n"
"Solusi: Catat Kehadiran setiap baris daftar instruktur sebelum\n"
"menandai sesi sebagai selesai\n"

#. module: ssi_school_extracurricular_session
#: code:addons/ssi_school_extracurricular_session/models/school_extracurricular_session.py:0
#, python-format
msgid ""
"\n"
"Context: Mark extracurricular session as done\n"
"Database ID: %s\n"
"Problem: Session has no attendance line\n"
"Solution: Record at least one attendance line before marking the\n"
"session as done\n"
msgstr ""
"\n"
"Konteks: Tandai sesi ekstrakurikuler selesai\n"
"ID Basis Data: %s\n"
"Masalah: Sesi tidak memiliki baris kehadiran\n"
"Solusi: Catat setidaknya satu baris kehadiran sebelum menandai sesi\n"
"sebagai selesai\n"

#. module: ssi_school_extracurricular_session
#: code:addons/ssi_school_extracurricular_session/models/school_extracurricular_session.py:0
#, python-format
msgid ""
"\n"
"Context: Mark extracurricular session as done\n"
"Database ID: %s\n"
