<odoo>
<record id="cancel_extracurricular_session_view_form" model="ir.ui.view">
    <field name="name">cancel_extracurricular_session - form</field>
    <field name="model">cancel_extracurricular_session</field>
    <field name="arch" type="xml">
        <form>
            <group name="group_1" colspan="4" col="2">
                <field name="session_id" invisible="1" />
                <field name="cancel_reason" />
            </group>
            <footer>
                <button
                        name="action_confirm"
                        type="object"
                        string="Confirm"
                        class="btn-primary"
                    />
                <button string="Cancel" class="btn-default" special="cancel" />
            </footer>
        </form>
    </field>
</record>
</odoo>
