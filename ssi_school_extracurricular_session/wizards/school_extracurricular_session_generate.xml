<odoo>
<record id="school_extracurricular_session_generate_view_form" model="ir.ui.view">
    <field name="name">school_extracurricular_session_generate - form</field>
    <field name="model">school_extracurricular_session_generate</field>
    <field name="arch" type="xml">
        <form>
            <group name="group_1" colspan="4" col="2">
                <field name="offering_id" />
                <field name="date_start" />
                <field name="date_end" />
                <field name="time_start" widget="float_time" />
                <field name="time_end" widget="float_time" />
                <field name="teacher_id" />
                <field name="location" />
            </group>
            <group name="group_weekday" string="Weekdays" colspan="4" col="7">
                <field name="mon" />
                <field name="tue" />
                <field name="wed" />
                <field name="thu" />
                <field name="fri" />
                <field name="sat" />
                <field name="sun" />
            </group>
            <footer>
                <button
                        name="action_generate"
                        type="object"
                        string="Generate"
                        class="btn-primary"
                    />
                <button string="Cancel" class="btn-default" special="cancel" />
            </footer>
        </form>
    </field>
</record>

<record
        id="school_extracurricular_session_generate_action"
        model="ir.actions.act_window"
    >
    <field name="name">Generate Sessions</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_extracurricular_session_generate</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
</record>
</odoo>
